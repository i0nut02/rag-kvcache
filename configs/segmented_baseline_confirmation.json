{
  "command": "matrix",
  "matrix_type": "selected-inference-control",
  "dataset": "data/quality-v1.0.1/QuALITY.v1.0.1.htmlstripped.dev",
  "split": "dev",
  "verify_counts": true,
  "model": "Qwen/Qwen2.5-1.5B-Instruct",
  "tokenizer": "Qwen/Qwen2.5-1.5B-Instruct",
  "device": "cuda",
  "dtype": "float16",
  "no_inference": false,
  "output_root": "results/inference_confirmation",
  "seed": 42,
  "block_tokens": 16,
  "progress_every": 10,
  "profiles": {
    "smoke": {"limit": 10},
    "confirmation": {"limit": 100},
    "full": {"limit": null}
  },
  "runs": [
    {
      "name": "01_uncached_random_fp16",
      "workload": "random",
      "policy": "none",
      "baseline_mode": "full",
      "storage": "accelerator-fp16",
      "cache_strategy": "document"
    },
    {
      "name": "01b_segmented_uncached_random_fp16",
      "workload": "random",
      "policy": "none",
      "baseline_mode": "segmented",
      "storage": "accelerator-fp16",
      "cache_strategy": "document",
      "reference_run": "01_uncached_random_fp16"
    },
    {
      "name": "06_uncached_zipf_fp16",
      "workload": "zipf",
      "policy": "none",
      "baseline_mode": "full",
      "storage": "accelerator-fp16",
      "cache_strategy": "document"
    },
    {
      "name": "06b_segmented_uncached_zipf_fp16",
      "workload": "zipf",
      "policy": "none",
      "baseline_mode": "segmented",
      "storage": "accelerator-fp16",
      "cache_strategy": "document",
      "reference_run": "06_uncached_zipf_fp16"
    }
  ]
}
