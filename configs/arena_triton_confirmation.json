{
  "dataset": "data/quality-v1.0.1/QuALITY.v1.0.1.htmlstripped.dev",
  "split": "dev",
  "verify_counts": true,
  "model": "Qwen/Qwen2.5-1.5B-Instruct",
  "device": "cuda",
  "dtype": "float16",
  "seed": 42,
  "budget_mb": 4096,
  "block_tokens": 256,
  "progress_every": 10,
  "output_root": "results/arena_triton",
  "profiles": {
    "smoke": {
      "limit": 10
    },
    "confirmation": {
      "limit": 100
    },
    "full": {
      "limit": null
    }
  },
  "runs": [
    {
      "name": "segmented_random_fp16",
      "workload": "random",
      "policy": "none",
      "baseline_mode": "segmented",
      "storage": "accelerator-fp16",
      "cache_strategy": "document"
    },
    {
      "name": "document_tensor_random_fp16_4gib",
      "workload": "random",
      "policy": "lru",
      "storage": "accelerator-fp16",
      "cache_strategy": "document",
      "kv_backend": "tensor",
      "reference_run": "segmented_random_fp16"
    },
    {
      "name": "document_arena64_random_fp16_4gib",
      "workload": "random",
      "policy": "lru",
      "storage": "accelerator-fp16",
      "cache_strategy": "document",
      "kv_backend": "arena",
      "arena_page_tokens": 64,
      "reference_run": "segmented_random_fp16"
    },
    {
      "name": "document_arena256_random_fp16_4gib",
      "workload": "random",
      "policy": "lru",
      "storage": "accelerator-fp16",
      "cache_strategy": "document",
      "kv_backend": "arena",
      "arena_page_tokens": 256,
      "reference_run": "segmented_random_fp16"
    },
    {
      "name": "document_pytorch_random_int8_4gib",
      "workload": "random",
      "policy": "lru",
      "storage": "cpu-int8",
      "cache_strategy": "document",
      "int8_restore_backend": "pytorch",
      "reference_run": "segmented_random_fp16"
    },
    {
      "name": "document_triton_random_int8_4gib",
      "workload": "random",
      "policy": "lru",
      "storage": "cpu-int8",
      "cache_strategy": "document",
      "int8_restore_backend": "triton",
      "reference_run": "segmented_random_fp16"
    }
  ]
}
