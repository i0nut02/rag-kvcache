{
  "command": "matrix",
  "matrix_type": "selected-inference",
  "dataset": "data/quality-v1.0.1/QuALITY.v1.0.1.htmlstripped.dev",
  "split": "dev",
  "verify_counts": true,
  "model": "Qwen/Qwen2.5-1.5B-Instruct",
  "tokenizer": "Qwen/Qwen2.5-1.5B-Instruct",
  "device": "cuda",
  "dtype": "float16",
  "no_inference": false,
  "output_root": "results/full_dev_confirmation",
  "seed": 42,
  "budget_mb": 4096,
  "block_tokens": 16,
  "agreement_atol": 0.0625,
  "progress_every": 50,
  "profiles": {
    "smoke": {"limit": 10},
    "confirmation": {"limit": 300},
    "full": {"limit": null}
  },
  "runs": [
    {
      "name": "01_segmented_random_fp16",
      "workload": "random",
      "policy": "none",
      "baseline_mode": "segmented",
      "storage": "accelerator-fp16",
      "cache_strategy": "document"
    },
    {
      "name": "02_document_lru_random_fp16_4gib",
      "workload": "random",
      "policy": "lru",
      "storage": "accelerator-fp16",
      "cache_strategy": "document",
      "reference_run": "01_segmented_random_fp16"
    },
    {
      "name": "03_fixed_block_256_lru_random_fp16_4gib",
      "workload": "random",
      "policy": "lru",
      "storage": "accelerator-fp16",
      "cache_strategy": "fixed-block",
      "block_tokens": 256,
      "reference_run": "01_segmented_random_fp16"
    },
    {
      "name": "04_radix_lru_random_fp16_4gib",
      "workload": "random",
      "policy": "lru",
      "storage": "accelerator-fp16",
      "cache_strategy": "radix",
      "reference_run": "01_segmented_random_fp16"
    },
    {
      "name": "05_document_lru_random_cpu_fp16_4gib",
      "workload": "random",
      "policy": "lru",
      "storage": "cpu-fp16",
      "cache_strategy": "document",
      "reference_run": "01_segmented_random_fp16"
    },
    {
      "name": "06_document_lru_random_int8_triton_4gib",
      "workload": "random",
      "policy": "lru",
      "storage": "cpu-int8",
      "cache_strategy": "document",
      "int8_restore_backend": "triton",
      "reference_run": "01_segmented_random_fp16"
    },
    {
      "name": "07_segmented_zipf_fp16",
      "workload": "zipf",
      "policy": "none",
      "baseline_mode": "segmented",
      "storage": "accelerator-fp16",
      "cache_strategy": "document"
    },
    {
      "name": "08_document_lru_zipf_fp16_4gib",
      "workload": "zipf",
      "policy": "lru",
      "storage": "accelerator-fp16",
      "cache_strategy": "document",
      "reference_run": "07_segmented_zipf_fp16"
    },
    {
      "name": "09_fixed_block_256_lru_zipf_fp16_4gib",
      "workload": "zipf",
      "policy": "lru",
      "storage": "accelerator-fp16",
      "cache_strategy": "fixed-block",
      "block_tokens": 256,
      "reference_run": "07_segmented_zipf_fp16"
    },
    {
      "name": "10_radix_lru_zipf_fp16_4gib",
      "workload": "zipf",
      "policy": "lru",
      "storage": "accelerator-fp16",
      "cache_strategy": "radix",
      "reference_run": "07_segmented_zipf_fp16"
    },
    {
      "name": "11_document_gdsf_zipf_fp16_4gib",
      "workload": "zipf",
      "policy": "gdsf",
      "storage": "accelerator-fp16",
      "cache_strategy": "document",
      "reference_run": "07_segmented_zipf_fp16"
    },
    {
      "name": "12_document_lru_zipf_int8_triton_4gib",
      "workload": "zipf",
      "policy": "lru",
      "storage": "cpu-int8",
      "cache_strategy": "document",
      "int8_restore_backend": "triton",
      "reference_run": "07_segmented_zipf_fp16"
    }
  ]
}
